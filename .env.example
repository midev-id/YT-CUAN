# URL publik dashboard (dipakai untuk OAuth redirect). Wajib HTTPS kalau bukan localhost.
BASE_URL=https://yt.contoh.com

# Login dashboard
ADMIN_USER=admin
ADMIN_PASSWORD=ganti-dengan-password-panjang

# Kunci enkripsi token & stream key. Buat dengan:
#   docker run --rm python:3.12-slim python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# JANGAN diganti setelah ada channel terhubung (token lama tidak bisa dibaca).
SECRET_KEY=

# Google Cloud OAuth client (tipe "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opsional
# PORT=8000
# TRANSCODE_CONCURRENCY=1      # file yang di-encode bersamaan
# MAX_ACTIVE_BROADCASTS=30     # batas live aktif seluruh sistem
# JOB_DELAY_SEC=60             # jeda antar pembuatan broadcast
# QUOTA_LIMIT=10000            # kuota YouTube API per hari
# MAX_RECONNECTS=10            # reconnect gagal beruntun sebelum key dihentikan
# KEY_MAX_BROADCAST_FAILS=3    # broadcast gagal beruntun sebelum slot key dijeda
